# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Secret key (sucessora da service_role). Nunca use a publishable key aqui.
SUPABASE_SECRET_KEY=sb_secret_xxxxx

# Autenticação fixa do painel
AUTH_USER=olyra
AUTH_PASSWORD=troque-por-uma-senha-forte
SESSION_SECRET=string-aleatoria-longa-e-unica

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx
RESEND_FROM=onboarding@resend.dev

# Opcional. Sem domínio verificado, a Resend só entrega no endereço dono da
# conta — qualquer outro destinatário é recusado com HTTP 403. Preenchendo esta
# variável com esse endereço, todo envio é desviado para lá e o email chega com
# uma tarja informando para quem ele iria. Deixe vazia quando houver domínio
# verificado: aí o lead recebe direto.
MAIL_REDIRECT_TO=
